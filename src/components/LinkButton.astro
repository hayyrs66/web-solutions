---
const { title, href, bg, icon } = Astro.props;
import { Icon } from "astro-icon/components";

const dynamicStyles = {
  true: "flex w-fit items-center text-font-paragraph text-black tracking-tight font-medium text-sm bg-[#00FF7F] py-2 px-3 rounded-lg",
  false:
    "flex w-fit items-center text-font-paragraph text-white gap-2 tracking-tight font-medium text-sm py-2 px-3 rounded-lg",
};
---

<a href={href} class={dynamicStyles[bg]}>
  {title}
  {icon && <Icon name={icon} color="#fff" size={16} />}
</a>
