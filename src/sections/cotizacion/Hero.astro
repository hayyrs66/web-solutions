---
import { defaultStyles } from "@styles/index";
import { Icon } from "astro-icon/components";
---

<section
  class="w-full h-screen mt-[8rem] flex flex-col bg-primary/5 rounded-xl p-12"
>
  <!-- Effects -->
  <img
    class="absolute top-0 left-0 -z-10 opacity-50"
    src="elipse.png"
    alt="elipse gradient effect"
  />
  <!--  /Effects -->

  <!-- GRID HERO COTIZADOR SECTION -->

  <div class="grid grid-cols-2 w-full">
    <!-- Grid container 1 -->
    <div class="flex flex-col">
      <div class="flex flex-col">
        <h1 class="text-4xl text-white font-bold">
          Cotiza tu <span class="text-primary">Sitio Web</span>
        </h1>
        <p class={defaultStyles.paragraph + " mt-4"}>
          Acá detallarás los requerimientos principales para tu sitio web.
          Nosotros lo haremos realidad.
        </p>
      </div>
      <div class="flex flex-col mt-8">
        <h5
          class={`text-white text-lg font-medium tracking-tight flex gap-2 items-center`}
        >
          <Icon name="support" size={20} />Opciones principales
        </h5>
        <!-- Selector 1 -->
        <div class="flex flex-col gap-2 mt-5">
          <label
            for="amount-select"
            class="text-white text-base font-medium tracking-tight"
          >
            Presupuesto base.
          </label>
          <selectG
            class="bg-primary/50 text-white outline-none border-none py-2 px-1 
            [&>option]:bg-black/80 [&>option]:outline-none 
            [&>option]:border-none [&>option]:text-white"
            name="amounts"
            id="amount-select"
          >
            <option value="">Escoge un monto.</option>
            <option value={150}>150 USD</option>
            <option value={500}>500 USD</option>
            <option value={1000}>1000 USD</option>
          </select>
        </div>
        <!-- /Selector 1 -->
      </div>
    </div>
    <!-- /Grid container 1 -->

    <!-- Grid container 2 -->
    <div></div>
    <!-- /Grid container 2 -->
  </div>

  <!-- /GRID HERO COTIZADOR SECTION -->
</section>
