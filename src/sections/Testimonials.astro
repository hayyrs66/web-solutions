---
import { defaultStyles } from "@styles/index";
import { testimonials } from "@constants/index";
---

<section class="w-full bg-[#101111] p-[4rem]">
  <span class={defaultStyles.subtitleBtn}>Clientes</span>
  <h4 class="text-white text-5xl font-semibold tracking-tight mt-8">
    ¿Qué dicen sobre nosotros?
  </h4>
  <!-- Testimonial GRID -->
  <div class="grid grid-cols-3 gap-4 w-full mt-8">
    {
      testimonials.map((item, index) => (
        <div class="bg-[#1d1f1f] p-6 rounded-lg">
          {/* profile */}
          <div class="flex gap-2 items-center">
            <div class="w-[40px] h-[40px] bg-white rounded-full" />
            <div class="flex flex-col justify-center">
              <h5 class="text-white text-lg font-medium tracking-tight">
                {item.name}
              </h5>
              <span class="text-white/50 text-sm font-normal tracking-tight">
                {item.position}
              </span>
            </div>
          </div>
          {/* profile */}
          <p class={`${defaultStyles.paragraph} text-white/60 mt-4`}>{item.comment}</p>
        </div>
      ))
    }
  </div>
  <!-- /Testimonial GRID -->
</section>
