---
import LinkButton from "@components/LinkButton.astro";
---

<header
  class="fixed top-0 left-0 w-full flex justify-center gap-20 items-center py-3 px-[5rem] backdrop-blur border-b border-b-black/10"
>
  <div class="flex flex-grow basis-0 justify-end">
    <img src="logo.png" width="90" />
  </div>
  <nav
    class="flex items-center justify-center gap-2 [&>a]:text-sm [&>a]:font-medium [&>a]:tracking-tight"
  >
    <a href="#" class="text-black">Servicio</a>
    <a href="#" class="text-black">Nosotros</a>
    <a href="#" class="text-black">Testimonios</a>
    <a href="#" class="text-black">Contacto</a>
  </nav>
  <div class="flex-grow basis-0">
    <nav>
      <LinkButton title="Estado de Cotización" href="#" bg={true} />
    </nav>
  </div>
</header>
