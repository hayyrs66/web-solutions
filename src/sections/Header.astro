---
import LinkButton from "@components/LinkButton.astro";
---

<header
  class="fixed top-0 z-20 left-0 w-full flex justify-between gap-20 items-center py-3 px-[5rem] backdrop-blur border-b border-b-white/10"
>
  <div class="flex flex-grow basis-0 items-center">
    <a href="/">
      <img src="logo.png" width="90" />
    </a>
  </div>
  <nav
    class="flex items-center justify-center gap-2 [&>a]:text-sm [&>a]:font-medium [&>a]:tracking-tight"
  >
    <a href="#" class="text-white">Servicio</a>
    <a href="#" class="text-white">Testimonios</a>
    <a href="#" class="text-white">Contacto</a>
  </nav>
  <div class="flex flex-grow basis-0 justify-end">
    <nav>
      <LinkButton title="Estado de Cotización" href="#" bg={true} />
    </nav>
  </div>
</header>
