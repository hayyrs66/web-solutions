---
import { defaultStyles } from "@styles/index";
import { Icon } from "astro-icon/components";
---

<section class="w-full px-[4rem] mt-[5rem] pb-[10rem]">
  <!-- GRID -->
  <div class="w-full grid grid-cols-2">
    <!-- Grid container 1 -->
    <div class="">
      <div class="relative">
        <h4 class={defaultStyles.title + " text-5xl font-light leading-snug"}>
          No uses plantillas genéricas. Es hora de crear una <span class="bg-primary/20 px-1 py-1 rounded-2xl">identidad.</span>
        </h4>
        <img src="line.png" alt="" class="w-[200px] absolute bottom-[-10%] right-[25%]" />
      </div>
      <p class={defaultStyles.paragraph + " mt-16"}>
        Nuestros servicios personalizados te permiten tener un sitio web único y atractivo que refleje la esencia de tu marca.
    </div>
    <!-- Grid container 2 -->
    <div class="">
      <img src="projects.webp" alt="" class="w-full rounded-xl">
    </div>
  </div>
  <!-- /GRID -->
</section>
